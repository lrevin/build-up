# AWS 자격 증명은 코드나 이 파일에 넣지 않습니다.
# EC2에서는 연결된 IAM Role의 임시 자격 증명을 사용합니다.

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=YOUR_PRIVATE_S3_BUCKET
AWS_EC2_METADATA_V1_DISABLED=true

BUILDUP_S3_CONNECTION_CHECK_ENABLED=false
BUILDUP_S3_MAX_PHOTO_SIZE_BYTES=10485760
BUILDUP_S3_MAX_FILE_SIZE_BYTES=20971520
BUILDUP_S3_MAX_FILE_SIZE=20MB
BUILDUP_S3_MAX_REQUEST_SIZE=21MB
