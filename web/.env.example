# 이 파일을 복사해 .env.local 로 만들어 사용 (.env.local 은 커밋 금지)

# true(기본값): 서버 없이 src/mocks 의 더미 데이터로 동작
# false: 실제 Spring Boot 서버(/api)로 요청
VITE_USE_DUMMY=true

# 비워두면 '/api' (vite proxy → localhost:8080)
VITE_API_BASE_URL=

# 카카오 개발자 앱 REST API 키 (넣으면 로그인·가입 화면에 카카오 버튼이 보임)
# 카카오 콘솔 Redirect URI 에 http://localhost:5173/oauth/kakao/callback 등록 필요
VITE_KAKAO_REST_API_KEY=
