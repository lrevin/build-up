# 리눅스 서버에서 자동 실행(재부팅해도 켜짐) 설정 예시
# /etc/systemd/system/buildup.service 로 복사 후:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now buildup
#   상태 보기: sudo systemctl status buildup / 로그: journalctl -u buildup -f

[Unit]
Description=Build Up server
Wants=network-online.target
After=network-online.target mysql.service
# 계속 죽어도 재시작을 포기하지 않는다(기본값은 10초에 5번 넘게 죽으면 멈춤)
StartLimitIntervalSec=0

[Service]
User=buildup
WorkingDirectory=/opt/buildup
# DB 주소·비밀번호 등은 이 파일에(권한 600, 다른 사람이 못 읽게)
EnvironmentFile=/opt/buildup/buildup.env
# 메모리가 모자라 멈추면(OutOfMemoryError) 그대로 매달려 있지 말고 바로 꺼져서 다시 켜지게
ExecStart=/usr/bin/java -Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError -jar /opt/buildup/buildup-server.jar --spring.profiles.active=prod
SuccessExitStatus=143
# 오류든, 누가 kill 했든, 정상 종료든 무조건 5초 뒤 다시 켠다
Restart=always
RestartSec=5
# 메모리가 부족할 때 리눅스가 다른 것보다 이 서버를 나중에 죽이게
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
