# BuildUp 운영 서버용 systemd 서비스
# /etc/systemd/system/buildup.service 로 설치한 후 daemon-reload 및 restart한다.

[Unit]
Description=BuildUp Spring Boot API
Wants=network-online.target
After=network-online.target
# 영구적인 설정 오류가 있을 때 무한 재시작하지 않도록 1분에 5회로 제한한다.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=buildup
Group=buildup
WorkingDirectory=/opt/buildup
EnvironmentFile=/etc/buildup/buildup.env
LogsDirectory=buildup
LogsDirectoryMode=0750
# OutOfMemoryError가 발생하면 JVM을 종료하고 Restart=on-failure가 복구한다.
ExecStart=/usr/bin/java -Xms256m -Xmx512m -XX:+ExitOnOutOfMemoryError -jar /opt/buildup/buildup.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
